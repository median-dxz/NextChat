{
  "name": "nextchat",
  "private": false,
  "license": "mit",
  "scripts": {
    "mask": "pnpm exec tsx app/masks/build.ts",
    "mask:watch": "pnpm exec watch \"pnpm run mask\" app/masks",
    "dev": "concurrently -r \"pnpm run mask:watch\" \"next dev\"",
    "build": "node scripts/build.mjs standalone",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "export": "node scripts/build.mjs export",
    "export:dev": "concurrently -r \"pnpm run mask:watch\" \"cross-env BUILD_MODE=export BUILD_APP=1 next dev\"",
    "app:dev": "concurrently -r \"pnpm run mask:watch\" \"pnpm exec tauri dev\"",
    "app:build": "pnpm run mask && pnpm exec tauri build",
    "app:clear": "pnpm exec tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky install",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf pnpm run dev",
    "test": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci"
  },
  "dependencies": {
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@next/third-parties": "16",
    "@svgr/webpack": "^6.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-updater": "~2.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.0.2",
    "axios": "^1.7.5",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.9.2",
    "fuse.js": "^7.0.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.11",
    "idb-keyval": "^6.2.1",
    "lodash-es": "^4.17.21",
    "markdown-to-txt": "^2.0.1",
    "mermaid": "^10.6.1",
    "nanoid": "^5.0.3",
    "next": "16",
    "node-fetch": "^3.3.1",
    "openapi-client-axios": "^7.5.5",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.15.0",
    "rehype-highlight": "^6.0.0",
    "rehype-katex": "^6.0.3",
    "remark-breaks": "^3.0.2",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "rt-client": "https://github.com/Azure-Samples/aoai-realtime-audio-sdk/releases/download/js/v0.5.0/rt-client-0.5.0.tgz",
    "sass": "^1.59.2",
    "spark-md5": "^3.0.2",
    "use-debounce": "^9.0.4",
    "zod": "^4.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/react-katex": "^3.0.0",
    "@types/spark-md5": "^3.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "9",
    "eslint-config-next": "16",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^8.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^13.2.2",
    "prettier": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "5",
    "watch": "^1.0.2",
    "webpack": "^5.88.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.11.0"
}
