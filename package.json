{
  "name": "nextchat",
  "private": false,
  "license": "mit",
  "scripts": {
    "mask": "pnpm exec tsx app/masks/build.ts",
    "mask:watch": "pnpm exec tsx watch app/masks/build.ts",
    "dev": "concurrently -r \"pnpm run mask:watch\" \"next dev\"",
    "build": "pnpm run typecheck && node scripts/build.mjs standalone",
    "start": "next start",
    "lint": "node --require ./scripts/typescript-eslint-compat.cjs ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "next typegen && tsc --noEmit",
    "export": "pnpm run typecheck && node scripts/build.mjs export",
    "export:dev": "concurrently -r \"pnpm run mask:watch\" \"cross-env BUILD_MODE=export BUILD_APP=1 next dev\"",
    "app:dev": "concurrently -r \"pnpm run mask:watch\" \"pnpm exec tauri dev\"",
    "app:build": "pnpm run mask && pnpm exec tauri build",
    "app:clear": "pnpm exec tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf pnpm run dev",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@next/third-parties": "16",
    "@svgr/webpack": "^8.1.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "fuse.js": "^7.4.2",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "katex": "0.16.47",
    "lodash-es": "^4.18.1",
    "markdown-to-txt": "^2.0.1",
    "mermaid": "^11.16.0",
    "nanoid": "^5.1.16",
    "next": "16",
    "openapi-client-axios": "^7.9.0",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rt-client": "https://github.com/Azure-Samples/aoai-realtime-audio-sdk/releases/download/js/v0.5.0/rt-client-0.5.0.tgz",
    "sass": "^1.101.0",
    "spark-md5": "^3.0.2",
    "use-debounce": "^10.1.1",
    "zod": "^4.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/react-katex": "^3.0.4",
    "@types/spark-md5": "^3.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-next": "16",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "espree": "^11.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "typescript-eslint-compat": "npm:typescript@6.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.11.0"
}
